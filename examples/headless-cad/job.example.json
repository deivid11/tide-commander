{
  "workspace": "/absolute/path/to/tide-commander/examples/headless-cad",
  "script": "model.py",
  "parameters": {
    "length": 40,
    "width": 28,
    "height": 8,
    "holeDiameter": 5
  },
  "outputs": [
    { "format": "fcstd", "path": "generated/example.FCStd", "document": "HeadlessCadExample" },
